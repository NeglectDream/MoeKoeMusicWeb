{
  "name": "moekoemusic",
  "version": "1.6.9",
  "homepage": "https://music.moekoe.cn/",
  "scripts": {
    "install-all": "npm install && npm --prefix ../KuGouMusicApi install",
    "serve": "vite",
    "build": "vite build",
    "build:docker": "cross-env VITE_APP_API_URL=/api vite build",
    "preview": "vite preview",
    "api": "cd ../KuGouMusicApi && node app.js --platform=lite --port=6521",
    "dev": "concurrently -n api,web -c cyan,green \"npm:api\" \"npm:serve\""
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "author": {
    "name": "MoeJue",
    "email": "MoeJue@qq.com"
  },
  "blog": "MoeJue.cn",
  "license": "GPL-2.0-only",
  "description": "MoeKoe Music",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/compiler-sfc": "^3.5.12",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "esbuild": "0.25.11",
    "sass-embedded": "^1.99.0",
    "vite": "^7.2.6"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "crypto-js": "^4.2.0",
    "music-metadata": "^11.7.3",
    "pinia": "^3.0.0",
    "pinia-plugin-persistedstate": "^4.1.1",
    "vue": "^3.5.12",
    "vue-i18n": "^10.0.4",
    "vue-router": "^4.4.5",
    "vue3-virtual-scroller": "^0.2.3"
  }
}
